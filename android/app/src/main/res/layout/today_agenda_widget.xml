<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFF7E7"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/today_agenda_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/today_agenda_widget_title"
        android:textColor="#2D2013"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/today_agenda_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/today_agenda_widget_empty"
        android:textColor="#5F4A33"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/today_agenda_items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#2D2013"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/today_agenda_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/today_agenda_widget_hint"
        android:textColor="#7B6248"
        android:textSize="12sp" />
</LinearLayout>
